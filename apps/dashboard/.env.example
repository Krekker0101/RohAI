# Leave VITE_API_BASE_URL empty when the dashboard is served by FastAPI at /dashboard/.
# Set it only when the browser must connect directly to a backend on another origin.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Vite dev-server proxy target. This avoids CORS during local development.
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000

# Keep /dashboard/ when FastAPI serves apps/dashboard/dist.
VITE_BASE_PATH=/dashboard/
