{
  "$defs": {
    "ObjectKind": {
      "enum": [
        "car",
        "bus",
        "truck",
        "motorcycle",
        "bicycle",
        "pedestrian",
        "emergency_vehicle",
        "unknown"
      ],
      "title": "ObjectKind",
      "type": "string"
    },
    "SupportedInput": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "BGR_uint8_HWC",
          "default": "BGR_uint8_HWC",
          "title": "Format",
          "type": "string"
        },
        "channels": {
          "const": 3,
          "default": 3,
          "title": "Channels",
          "type": "integer"
        },
        "image_size": {
          "maximum": 1536,
          "minimum": 256,
          "multipleOf": 32,
          "title": "Image Size",
          "type": "integer"
        }
      },
      "required": [
        "image_size"
      ],
      "title": "SupportedInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "compatibility_schema": {
      "const": "rohai-model-package-1",
      "default": "rohai-model-package-1",
      "title": "Compatibility Schema",
      "type": "string"
    },
    "annotation_schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Annotation Schema Version",
      "type": "string"
    },
    "architecture": {
      "const": "YOLO26n",
      "default": "YOLO26n",
      "title": "Architecture",
      "type": "string"
    },
    "task": {
      "const": "detect",
      "default": "detect",
      "title": "Task",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "dataset_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dataset Hash",
      "type": "string"
    },
    "training_run": {
      "title": "Training Run",
      "type": "string"
    },
    "training_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Training Manifest Sha256",
      "type": "string"
    },
    "class_mapping": {
      "additionalProperties": {
        "$ref": "#/$defs/ObjectKind"
      },
      "title": "Class Mapping",
      "type": "object"
    },
    "supported_input": {
      "$ref": "#/$defs/SupportedInput"
    },
    "expected_calibration": {
      "const": "validated_metric_road_plane_and_fresh_alignment",
      "default": "validated_metric_road_plane_and_fresh_alignment",
      "title": "Expected Calibration",
      "type": "string"
    },
    "files": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "title": "Files",
      "type": "object"
    },
    "package_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Package Sha256",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "dataset_version",
    "dataset_hash",
    "training_run",
    "training_manifest_sha256",
    "class_mapping",
    "supported_input",
    "files",
    "package_sha256"
  ],
  "title": "ModelPackage",
  "type": "object"
}
