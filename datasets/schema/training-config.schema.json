{
  "$defs": {
    "Augmentation": {
      "additionalProperties": false,
      "properties": {
        "hsv_h": {
          "default": 0.015,
          "maximum": 1,
          "minimum": 0,
          "title": "Hsv H",
          "type": "number"
        },
        "hsv_s": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Hsv S",
          "type": "number"
        },
        "hsv_v": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Hsv V",
          "type": "number"
        },
        "degrees": {
          "default": 0,
          "maximum": 180,
          "minimum": 0,
          "title": "Degrees",
          "type": "number"
        },
        "translate": {
          "default": 0.05,
          "maximum": 1,
          "minimum": 0,
          "title": "Translate",
          "type": "number"
        },
        "scale": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Scale",
          "type": "number"
        },
        "shear": {
          "default": 0,
          "maximum": 180,
          "minimum": 0,
          "title": "Shear",
          "type": "number"
        },
        "perspective": {
          "default": 0,
          "maximum": 0.001,
          "minimum": 0,
          "title": "Perspective",
          "type": "number"
        },
        "flipud": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Flipud",
          "type": "number"
        },
        "fliplr": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Fliplr",
          "type": "number"
        },
        "mosaic": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Mosaic",
          "type": "number"
        },
        "mixup": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Mixup",
          "type": "number"
        },
        "cutmix": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Cutmix",
          "type": "number"
        },
        "copy_paste": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Copy Paste",
          "type": "number"
        },
        "close_mosaic": {
          "default": 0,
          "minimum": 0,
          "title": "Close Mosaic",
          "type": "integer"
        }
      },
      "title": "Augmentation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "purpose": {
      "default": "field",
      "enum": [
        "field",
        "synthetic_fixture"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "deployment_domain": {
      "default": "UNSPECIFIED",
      "enum": [
        "UNSPECIFIED",
        "PHYSICAL_MAKET",
        "REAL_ROAD"
      ],
      "title": "Deployment Domain",
      "type": "string"
    },
    "schema_version": {
      "const": "rohai-training-1",
      "default": "rohai-training-1",
      "title": "Schema Version",
      "type": "string"
    },
    "experiment": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Experiment",
      "type": "string"
    },
    "base_model": {
      "format": "path",
      "title": "Base Model",
      "type": "string"
    },
    "base_manifest": {
      "format": "path",
      "title": "Base Manifest",
      "type": "string"
    },
    "dataset_release": {
      "format": "path",
      "title": "Dataset Release",
      "type": "string"
    },
    "dataset_version": {
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "dataset_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dataset Hash",
      "type": "string"
    },
    "baseline": {
      "format": "path",
      "title": "Baseline",
      "type": "string"
    },
    "seed": {
      "default": 2026,
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "image_size": {
      "default": 640,
      "maximum": 1536,
      "minimum": 256,
      "multipleOf": 32,
      "title": "Image Size",
      "type": "integer"
    },
    "epochs": {
      "default": 30,
      "maximum": 1000,
      "minimum": 1,
      "title": "Epochs",
      "type": "integer"
    },
    "batch": {
      "default": 8,
      "maximum": 1024,
      "minimum": 1,
      "title": "Batch",
      "type": "integer"
    },
    "optimizer": {
      "default": "AdamW",
      "enum": [
        "SGD",
        "Adam",
        "AdamW"
      ],
      "title": "Optimizer",
      "type": "string"
    },
    "lr0": {
      "default": 0.0001,
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Lr0",
      "type": "number"
    },
    "lrf": {
      "default": 0.1,
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Lrf",
      "type": "number"
    },
    "momentum": {
      "default": 0.937,
      "exclusiveMaximum": 1,
      "minimum": 0,
      "title": "Momentum",
      "type": "number"
    },
    "weight_decay": {
      "default": 0.0005,
      "maximum": 1,
      "minimum": 0,
      "title": "Weight Decay",
      "type": "number"
    },
    "warmup_epochs": {
      "default": 3,
      "minimum": 0,
      "title": "Warmup Epochs",
      "type": "number"
    },
    "cos_lr": {
      "default": false,
      "title": "Cos Lr",
      "type": "boolean"
    },
    "augmentation": {
      "$ref": "#/$defs/Augmentation"
    },
    "patience": {
      "default": 10,
      "minimum": 1,
      "title": "Patience",
      "type": "integer"
    },
    "device": {
      "default": "cpu",
      "pattern": "^(cpu|mps|[0-9]+)$",
      "title": "Device",
      "type": "string"
    },
    "workers": {
      "default": 0,
      "maximum": 32,
      "minimum": 0,
      "title": "Workers",
      "type": "integer"
    },
    "save_period": {
      "default": 1,
      "minimum": 1,
      "title": "Save Period",
      "type": "integer"
    },
    "freeze": {
      "default": 0,
      "maximum": 23,
      "minimum": 0,
      "title": "Freeze",
      "type": "integer"
    },
    "amp": {
      "default": false,
      "title": "Amp",
      "type": "boolean"
    },
    "deterministic": {
      "const": true,
      "default": true,
      "title": "Deterministic",
      "type": "boolean"
    }
  },
  "required": [
    "experiment",
    "dataset_release",
    "dataset_version",
    "dataset_hash",
    "baseline"
  ],
  "title": "TrainingConfig",
  "type": "object"
}
