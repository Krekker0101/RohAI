{
  "$defs": {
    "CameraFault": {
      "additionalProperties": false,
      "properties": {
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "directions": {
          "default": [
            "north",
            "south",
            "east",
            "west"
          ],
          "items": {
            "$ref": "#/$defs/Direction"
          },
          "title": "Directions",
          "type": "array"
        },
        "mode": {
          "enum": [
            "outage",
            "freeze",
            "occlusion",
            "calibration_invalid",
            "latency_spike"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "mode"
      ],
      "title": "CameraFault",
      "type": "object"
    },
    "DemandPeriod": {
      "additionalProperties": false,
      "properties": {
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "vehicles_per_minute": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/Direction"
          },
          "title": "Vehicles Per Minute",
          "type": "object"
        },
        "pedestrians_per_minute": {
          "default": 6,
          "maximum": 600,
          "minimum": 0,
          "title": "Pedestrians Per Minute",
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "vehicles_per_minute"
      ],
      "title": "DemandPeriod",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "north",
        "south",
        "east",
        "west"
      ],
      "title": "Direction",
      "type": "string"
    },
    "DomainRandomizationProfile": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "rationale": {
          "default": "Narrow engineering sensitivity ranges; not empirical uncertainty bounds",
          "title": "Rationale",
          "type": "string"
        },
        "arrival_multiplier": {
          "$ref": "#/$defs/RandomRange",
          "default": {
            "low": 0.9,
            "high": 1.1
          }
        },
        "headway_multiplier": {
          "$ref": "#/$defs/RandomRange",
          "default": {
            "low": 0.95,
            "high": 1.05
          }
        },
        "reaction_multiplier": {
          "$ref": "#/$defs/RandomRange",
          "default": {
            "low": 0.9,
            "high": 1.1
          }
        },
        "noise_multiplier": {
          "$ref": "#/$defs/RandomRange",
          "default": {
            "low": 0.9,
            "high": 1.1
          }
        },
        "latency_multiplier": {
          "$ref": "#/$defs/RandomRange",
          "default": {
            "low": 0.9,
            "high": 1.1
          }
        },
        "occlusion_multiplier": {
          "$ref": "#/$defs/RandomRange",
          "default": {
            "low": 0.9,
            "high": 1.1
          }
        },
        "camera_availability": {
          "$ref": "#/$defs/RandomRange",
          "default": {
            "low": 0.995,
            "high": 1.0
          }
        },
        "arrival_distributions": {
          "default": [
            "poisson"
          ],
          "items": {
            "enum": [
              "poisson",
              "regular",
              "bursty"
            ],
            "type": "string"
          },
          "title": "Arrival Distributions",
          "type": "array"
        }
      },
      "title": "DomainRandomizationProfile",
      "type": "object"
    },
    "Incident": {
      "additionalProperties": false,
      "properties": {
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "downstream": {
          "$ref": "#/$defs/Direction"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "downstream"
      ],
      "title": "Incident",
      "type": "object"
    },
    "PerceptionProfile": {
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "default": "engineering_assumption",
          "enum": [
            "engineering_assumption",
            "vision_benchmark_fit"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "benchmark_report_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benchmark Report Sha256"
        },
        "calibration_notes": {
          "default": "Uncalibrated stress-test parameters; not field estimates",
          "title": "Calibration Notes",
          "type": "string"
        },
        "missed_detection_probability": {
          "default": 0.03,
          "maximum": 1,
          "minimum": 0,
          "title": "Missed Detection Probability",
          "type": "number"
        },
        "false_positives_per_frame": {
          "default": 0.01,
          "maximum": 1,
          "minimum": 0,
          "title": "False Positives Per Frame",
          "type": "number"
        },
        "id_switch_probability": {
          "default": 0.001,
          "maximum": 1,
          "minimum": 0,
          "title": "Id Switch Probability",
          "type": "number"
        },
        "occlusion_probability": {
          "default": 0.01,
          "maximum": 1,
          "minimum": 0,
          "title": "Occlusion Probability",
          "type": "number"
        },
        "occlusion_duration_s": {
          "default": 0.5,
          "maximum": 60,
          "minimum": 0,
          "title": "Occlusion Duration S",
          "type": "number"
        },
        "position_noise_std_m": {
          "default": 0.15,
          "maximum": 10,
          "minimum": 0,
          "title": "Position Noise Std M",
          "type": "number"
        },
        "wait_noise_std_s": {
          "default": 0.1,
          "maximum": 30,
          "minimum": 0,
          "title": "Wait Noise Std S",
          "type": "number"
        },
        "queue_undercount_probability": {
          "default": 0.02,
          "maximum": 1,
          "minimum": 0,
          "title": "Queue Undercount Probability",
          "type": "number"
        },
        "camera_delay_s": {
          "default": 0.05,
          "maximum": 30,
          "minimum": 0,
          "title": "Camera Delay S",
          "type": "number"
        },
        "inference_latency_s": {
          "default": 0.1,
          "maximum": 30,
          "minimum": 0,
          "title": "Inference Latency S",
          "type": "number"
        },
        "frame_drop_probability": {
          "default": 0.01,
          "maximum": 1,
          "minimum": 0,
          "title": "Frame Drop Probability",
          "type": "number"
        },
        "fps": {
          "default": 4,
          "maximum": 30,
          "minimum": 0.1,
          "title": "Fps",
          "type": "number"
        },
        "minimum_fps": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Minimum Fps",
          "type": "number"
        },
        "stale_after_s": {
          "default": 3,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Stale After S",
          "type": "number"
        },
        "freeze_detection_s": {
          "default": 1,
          "maximum": 30,
          "minimum": 0,
          "title": "Freeze Detection S",
          "type": "number"
        },
        "track_ttl_s": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Track Ttl S",
          "type": "number"
        },
        "camera_availability": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Camera Availability",
          "type": "number"
        },
        "calibration_scale_error": {
          "default": 0.01,
          "maximum": 0.5,
          "minimum": -0.5,
          "title": "Calibration Scale Error",
          "type": "number"
        },
        "faults": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CameraFault"
          },
          "title": "Faults",
          "type": "array"
        }
      },
      "title": "PerceptionProfile",
      "type": "object"
    },
    "RandomRange": {
      "additionalProperties": false,
      "properties": {
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "RandomRange",
      "type": "object"
    },
    "ScenarioAssignment": {
      "additionalProperties": false,
      "properties": {
        "split": {
          "enum": [
            "TRAIN",
            "VALIDATION",
            "TEST",
            "CHALLENGE"
          ],
          "title": "Split",
          "type": "string"
        },
        "scenario": {
          "$ref": "#/$defs/ScenarioDefinition"
        }
      },
      "required": [
        "split",
        "scenario"
      ],
      "title": "ScenarioAssignment",
      "type": "object"
    },
    "ScenarioDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rohai-twin-1",
          "default": "rohai-twin-1",
          "title": "Schema Version",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Scenario Id",
          "type": "string"
        },
        "seed": {
          "default": 42,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "duration_s": {
          "default": 180,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Duration S",
          "type": "number"
        },
        "step_s": {
          "default": 0.25,
          "maximum": 0.5,
          "minimum": 0.05,
          "title": "Step S",
          "type": "number"
        },
        "traffic": {
          "$ref": "#/$defs/TrafficProfile"
        },
        "perception": {
          "$ref": "#/$defs/PerceptionProfile"
        },
        "randomization": {
          "$ref": "#/$defs/DomainRandomizationProfile"
        },
        "expected_invariants": {
          "default": [
            "conservation",
            "finite_storage",
            "no_conflicting_service",
            "observed_only_control",
            "finite_metrics"
          ],
          "items": {
            "enum": [
              "conservation",
              "finite_storage",
              "no_conflicting_service",
              "observed_only_control",
              "finite_metrics"
            ],
            "type": "string"
          },
          "title": "Expected Invariants",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "traffic"
      ],
      "title": "ScenarioDefinition",
      "type": "object"
    },
    "TrafficProfile": {
      "additionalProperties": false,
      "properties": {
        "periods": {
          "items": {
            "$ref": "#/$defs/DemandPeriod"
          },
          "minItems": 1,
          "title": "Periods",
          "type": "array"
        },
        "lanes_per_approach": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "title": "Lanes Per Approach",
          "type": "integer"
        },
        "lane_length_m": {
          "default": 90,
          "maximum": 1000,
          "minimum": 15,
          "title": "Lane Length M",
          "type": "number"
        },
        "downstream_capacity": {
          "default": 12,
          "maximum": 1000,
          "minimum": 1,
          "title": "Downstream Capacity",
          "type": "integer"
        },
        "downstream_travel_s": {
          "default": 5,
          "maximum": 120,
          "minimum": 0.25,
          "title": "Downstream Travel S",
          "type": "number"
        },
        "headway_s": {
          "default": 2,
          "maximum": 10,
          "minimum": 0.5,
          "title": "Headway S",
          "type": "number"
        },
        "reaction_s": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Reaction S",
          "type": "number"
        },
        "pedestrian_headway_s": {
          "default": 0.5,
          "maximum": 10,
          "minimum": 0.25,
          "title": "Pedestrian Headway S",
          "type": "number"
        },
        "crossing_s": {
          "default": 6,
          "maximum": 60,
          "minimum": 1,
          "title": "Crossing S",
          "type": "number"
        },
        "turn_probabilities": {
          "default": [
            0.15,
            0.7,
            0.15
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Turn Probabilities",
          "type": "array"
        },
        "vehicle_probabilities": {
          "default": [
            0.7,
            0.08,
            0.1,
            0.07,
            0.05
          ],
          "maxItems": 5,
          "minItems": 5,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Vehicle Probabilities",
          "type": "array"
        },
        "arrival_distribution": {
          "default": "poisson",
          "enum": [
            "poisson",
            "regular",
            "bursty"
          ],
          "title": "Arrival Distribution",
          "type": "string"
        },
        "burst_size": {
          "default": 4,
          "maximum": 20,
          "minimum": 1,
          "title": "Burst Size",
          "type": "integer"
        },
        "incidents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Incident"
          },
          "title": "Incidents",
          "type": "array"
        }
      },
      "required": [
        "periods"
      ],
      "title": "TrafficProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "rohai-control-splits-v1",
      "default": "rohai-control-splits-v1",
      "title": "Version",
      "type": "string"
    },
    "assignments": {
      "items": {
        "$ref": "#/$defs/ScenarioAssignment"
      },
      "minItems": 4,
      "title": "Assignments",
      "type": "array"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "assignments",
    "manifest_sha256"
  ],
  "title": "ScenarioSplits",
  "type": "object"
}
