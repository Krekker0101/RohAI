# Copy values into your local .env; generate a unique secret, never commit it.
STA_OPERATIONS_ENABLED=true
STA_OPERATOR_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_16_CHARACTERS
STA_OPERATIONS_DATABASE=.runtime/pilot/observations.sqlite3
STA_OPERATIONS_RETENTION_DAYS=30
STA_OPERATIONS_SITE_ID=pilot-01
# Optional separate token: reports/metrics only, no backup or traffic control.
# STA_OPERATIONS_VIEWER_TOKEN=ANOTHER_RANDOM_SECRET_AT_LEAST_16_CHARACTERS
# Default mode is SIMULATION. For observational road analytics use calibrated Vision.
# Road actuation remains blocked regardless of these settings.

# Optional local Pilot AI guide. Install the `pilot` extra and pinned model files first.
STA_PILOT__ENABLED=true
STA_PILOT__PROVIDER=local
STA_PILOT__MODEL_DIRECTORY=datasets/models/pilot
STA_PILOT__KNOWLEDGE_PATH=configs/pilot/knowledge.json
STA_PILOT__CPU_THREADS=4
STA_PILOT__REQUESTS_PER_MINUTE=20
