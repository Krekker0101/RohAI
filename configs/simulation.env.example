STA_MODE=simulation
STA_POLICY=adaptive
STA_TICK_SECONDS=0.5
STA_LOG_LEVEL=INFO
STA_SCENARIO__SEED=42
STA_SCENARIO__NORTH_PER_MINUTE=18
STA_SCENARIO__SOUTH_PER_MINUTE=12
STA_SCENARIO__EAST_PER_MINUTE=5
STA_SCENARIO__WEST_PER_MINUTE=4
STA_SCENARIO__PEDESTRIANS_PER_MINUTE=6
STA_TIMING__MIN_GREEN_SECONDS=8
STA_TIMING__MAX_GREEN_SECONDS=45
STA_TIMING__FIXED_GREEN_SECONDS=20
STA_TIMING__YELLOW_SECONDS=3
STA_TIMING__ALL_RED_SECONDS=2
# Set a non-empty token before exposing control endpoints beyond localhost.
# STA_OPERATOR_TOKEN=replace-with-your-local-secret
# For a separately hosted dashboard, allow its exact origin as JSON:
# STA_CORS_ORIGINS=["https://dashboard.example.com"]
